{
  "name": "text-extractor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:pipeline-core && npm run build:web && npm run build:server",
    "build:pipeline-core": "npm run build:pipeline-core:native && npm run build:pipeline-core:wasm",
    "build:pipeline-core:native": "bash scripts/runtime/build-pipeline-core-native.sh",
    "build:pipeline-core:wasm": "bash scripts/runtime/build-pipeline-core.sh",
    "build:web": "vite build --config web/vite.config.ts",
    "build:web:lite": "npm run model:browser-tessdata && npm run model:browser-reviewer && npm run build:pipeline-core:wasm && VITE_RUNTIME_MODE=lite vite build --config web/vite.config.ts",
    "build:pages": "VITE_BASE_PATH=/IttM/ npm run build:web:lite",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "build:server:standalone": "esbuild server.ts --bundle --platform=node --format=cjs --define:process.env.NODE_ENV='\"production\"' --log-override:empty-import-meta=silent --outfile=dist/server.cjs",
    "preview": "vite preview --config web/vite.config.ts",
    "clean": "rm -rf dist",
    "debug": "bash scripts/ci/debug.sh",
    "debug:doc-fixtures": "python3 scripts/debug/build-markdown-doc-fixtures.py",
    "debug:reference-block": "bash scripts/debug/debug-image-engines-parallel.sh",
    "debug:reference-screenshots": "bash scripts/debug/build-reference-screenshots.sh",
    "model:browser-reviewer": "bash scripts/models/download-browser-text-validator.sh",
    "model:browser-tessdata": "bash scripts/models/download-browser-tessdata.sh",
    "extract": "tsx scripts/cli/ittm-extract.ts",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "tsc --project web/tsconfig.json --noEmit && tsc --project gateway/tsconfig.json --noEmit && tsc --project edge/tsconfig.json --noEmit",
    "test": "node --import tsx --test web/src/**/*.test.ts gateway/src/**/*.test.ts edge/**/*.test.ts",
    "test:contract": "bash scripts/ci/run-contract-tests.sh",
    "test:smoke": "bash scripts/ci/run-smoke-tests.sh",
    "test:sast": "bash scripts/ci/run-sast.sh",
    "test:sca": "bash scripts/ci/run-sca.sh",
    "test:pages": "node scripts/ci/verify-pages-build.mjs dist /IttM/",
    "test:pipeline-docs": "python3 scripts/ci/verify_pipeline_profile_docs.py && python3 scripts/ci/verify_pipeline_flag_docs.py && python3 scripts/ci/verify_pipeline_abi_docs.py && python3 scripts/ci/verify-native-profiles.py",
    "test:pages:live": "node scripts/ci/smoke-pages.mjs",
    "test:compose": "bash scripts/ci/smoke-compose.sh",
    "test:resources": "bash scripts/ci/run-resource-tests.sh",
    "test:ocr:quality": "OCR_TEST_TIER=quality bash scripts/ci/run-resource-tests.sh",
    "test:ocr:browser": "npm run build:pipeline-core:wasm && node --import tsx web/src/ocr/browser-engine.ocr-test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "NODE_ENV=production node dist/server.js",
    "build:ocr-runtime": "cargo build --locked --release --manifest-path ocr-runtime/Cargo.toml",
    "test:ocr-runtime": "cargo test --locked --manifest-path ocr-runtime/Cargo.toml",
    "debug:native": "ocr-runtime/target/release/ittm-ocr debug"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "express": "^5.2.1",
    "mime-types": "^3.0.2",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "qs": "6.16.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  }
}
